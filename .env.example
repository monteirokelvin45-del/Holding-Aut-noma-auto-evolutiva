# =============================================================================
# AUTOMATON HOLDING CORP — Template de configuração (copiar para .env)
# Todas as chaves abaixo têm plano GRATUITO. O sistema arranca com ZERO chaves:
# nesse caso o LLM Router usa o motor heurístico determinístico local
# (LocalHeuristicProvider) e todos os conectores externos ficam em modo
# "dry-run auditado" (registam intenção, nunca inventam resultados).
# =============================================================================

# ---------------------------------------------------------------- Ambiente ---
APP_ENV=production                 # production | staging | development
LOG_LEVEL=INFO
TZ=Africa/Maputo
HOST=0.0.0.0
PORT=8000
# Segredo para assinar JWT do APK / sessões do Telegram (OBRIGATÓRIO em produção)
SECRET_KEY=troque-este-valor-por-uma-string-aleatoria-de-64-chars
# Token de acesso do APK ao backend (header X-Automaton-Token)
API_ACCESS_TOKEN=troque-este-token-do-apk
# Origens permitidas pelo CORS (separadas por vírgula; * apenas em desenvolvimento)
CORS_ORIGINS=*

# ------------------------------------------------------------------- Vault ---
VAULT_DIR=./vault_data
# Trava financeira global, em USD. Fase 0/1 = 0.00 (capital zero).
DAILY_SPEND_CAP_USD=0.00
# Teto de gasto por agente/dia, em USD.
PER_AGENT_DAILY_CAP_USD=0.00
# Qualquer gasto do fundo de reinvestimento acima disto exige biometria no APK.
APPROVAL_THRESHOLD_USD=5.00
# Moeda de reporte e taxa de câmbio de referência (atualizada pelo payout_bridge)
BASE_CURRENCY=USD
USD_MZN_RATE=63.50

# ================================================================ LLM FREE ===
# --- Groq (30 RPM / 1000 req/dia / 200k tokens/dia no free tier) -------------
GROQ_API_KEY=
GROQ_MODEL_REASONING=gpt-oss-120b
GROQ_MODEL_FAST=qwen3-27b
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
GROQ_TPD_LIMIT=200000

# --- Google AI Studio / Gemini (contexto longo) ------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM_LIMIT=10
GEMINI_RPD_LIMIT=250
GEMINI_TPD_LIMIT=250000

# --- OpenRouter (fallback; 20 RPM / 50 req/dia grátis) -----------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_RPM_LIMIT=20
OPENROUTER_RPD_LIMIT=50
# Após o primeiro upgrade de $10 do fundo de reinvestimento, subir para 1000.
OPENROUTER_RPD_LIMIT_UPGRADED=1000

# --- Ollama local (ilimitado) ------------------------------------------------
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ENABLED=false

# Ordem de preferência do roteador (separada por vírgula)
LLM_PROVIDER_ORDER=groq,gemini,openrouter,ollama,local

# ========================================================== OBSERVABILIDADE ===
# Langfuse (MIT) — self-hosted incluído no docker-compose
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000

# ================================================================ TELEGRAM ===
# Fallback de supervisão humana quando o APK não está disponível.
TELEGRAM_BOT_TOKEN=
# Lista de chat_ids autorizados a comandar o bot (separados por vírgula)
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLLING_ENABLED=false

# ================================================================ SEGURANÇA ===
# LLM Guard (MIT) — escudo anti prompt-injection no conteúdo raspado da web
LLM_GUARD_ENABLED=true
LLM_GUARD_FAIL_CLOSED=true
# Bloquear qualquer conteúdo raspado que contenha padrões de injeção
PROMPT_INJECTION_BLOCK_SCORE=0.85
# Máximo de bytes de conteúdo externo que entra num prompt
MAX_UNTRUSTED_CONTENT_CHARS=12000

# ============================================================== SCOUT / WEB ===
CRAWL4AI_ENABLED=false
GPT_RESEARCHER_ENABLED=false
# Fontes monitorizadas pelo Scout (24/7)
SCOUT_SOURCES=github_trending,reddit_sideproject,reddit_entrepreneur,reddit_passiveincome,gumroad,appsumo,youtube_trending,tiktok_creative
SCOUT_INTERVAL_MINUTES=360
# User-Agent identificável (respeito pelos ToS das plataformas)
SCOUT_USER_AGENT=AutomatonHoldingBot/1.0 (+https://github.com/automaton-holding; research)

# ============================================================== VALIDAÇÃO ====
# Metas mínimas do Smoke Test antes de desbloquear produção
SMOKE_MIN_CLICKS=25
SMOKE_MIN_CONVERSION_RATE=0.04
SMOKE_MIN_DAYS=3
SMOKE_MAX_DAYS=7
# Qualidade mínima do Juiz Eval (0-100). Abaixo disto, refazer.
EVAL_MIN_SCORE=85.0
EVAL_MAX_RETRIES=3

# ============================================================ MÍDIA / VÍDEO ===
PEXELS_API_KEY=
PIXABAY_API_KEY=
FFMPEG_BINARY=ffmpeg
VIDEO_OUTPUT_DIR=./vault_data/media/videos
VIDEO_TARGET_WIDTH=1080
VIDEO_TARGET_HEIGHT=1920
VIDEO_TARGET_FPS=30
VIDEO_MAX_DURATION_SECONDS=58
# TTS preferido: edge_tts | kokoro | chatterbox | piper
TTS_PROVIDER=edge_tts
TTS_VOICE_PT=pt-PT-RaquelNeural
TTS_VOICE_EN=en-US-AriaNeural
# MoneyPrinterTurbo / ShortGPT / AI-Youtube-Shorts-Generator
MONEYPRINTER_BASE_URL=http://moneyprinter:8080
SHORTGPT_ENABLED=false
YOUTUBE_SHORTS_GENERATOR_ENABLED=false
# ---- Geração de vídeo/imagem por IA aberta (custo $0.00) -------------------
# Liga o caminho "IA primeiro" na FootageProvider. Se nada estiver pronto, o
# sistema cai para Pexels -> Pixabay -> fundo procedimental (e registra o aviso).
GENAI_VIDEO_ENABLED=false
# Ordem de tentativa; os não configurados são ignorados.
GENAI_VIDEO_ORDER=wan22,longcat,kandinsky,ltx,sdxl
GENAI_TIMEOUT_SECONDS=600
# Endpoint compatível com `backend/squads/genai_server.py` (docker compose
# --profile gpu_video) ou qualquer API que devolva video_b64/video_url.
WAN22_ENDPOINT=
LONGCAT_ENDPOINT=
KANDINSKY_ENDPOINT=
LTX_ENDPOINT=
SDXL_ENDPOINT=

# ---- Pesquisa real (Crawl4AI / GPT-Researcher / extrator nativo) -----------
RESEARCH_ENABLED=true
RESEARCH_MAX_RESULTS=5
RESEARCH_TIMEOUT_SECONDS=240
# Chave para o GPT-Researcher (usa o mesmo LLM do SMART tier se vazio).
RESEARCH_LLM_PROVIDER=groq

# ============================================================== NEGÓCIOS =====
GUMROAD_ACCESS_TOKEN=
GUMROAD_EMAIL=
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
AMAZON_ASSOCIATE_TAG=
HOTMART_AFFILIATE_ID=
SHOPEE_AFFILIATE_ID=
ADSENSE_CLIENT_ID=
WORDPRESS_BASE_URL=
WORDPRESS_APP_PASSWORD=
GITHUB_TOKEN=
GITHUB_PAGES_BASE_URL=https://automaton-holding.github.io

# ============================================================== FINANCEIRO ===
TAX_RESERVE_RATE=0.05
# M-Pesa (Vodacom Moçambique) — developer.vodacom.co.mz
# SDK oficial: pip install paymentsds-mpesa (Apache-2.0). Se instalado, é usado
# primeiro; o fluxo HTTP directo (OAuth + B2C single stage) fica de reserva.
MPESA_BASE_URL=https://api.sandbox.vm.co.mz
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_ORIGIN=+258840000000
MPESA_INITIATOR_IDENTIFIER=
MPESA_INITIATOR_PASSWORD=
MPESA_SECURITY_CREDENTIAL=
MPESA_RECEIVER_MSISDN=+258840000000
MPESA_SANDBOX=true
# e-Mola (Movitel)
EMOLA_BASE_URL=https://api.emola.co.mz
EMOLA_API_KEY=
EMOLA_MERCHANT_CODE=
EMOLA_RECEIVER_MSISDN=+258860000000
# PayPal / Wise
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
WISE_API_TOKEN=
WISE_PROFILE_ID=
WISE_DEFAULT_TARGET_CURRENCY=MZN

# ================================================================ RH / LLM ===
# Limiar de ROI abaixo do qual o RH reescreve ou substitui um agente
HR_MIN_SUCCESS_RATE=0.60
HR_MAX_COST_PER_SUCCESS_USD=0.00
JUDGE_MIN_SCORE=85.0
