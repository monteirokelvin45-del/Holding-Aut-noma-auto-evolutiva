<?xml version="1.0" encoding="utf-8"?>
<!--
  Regras de extração de dados (Android 12+): o APK não guarda segredos em
  armazenamento de backup. Tokens e estado vivem apenas em memória.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
