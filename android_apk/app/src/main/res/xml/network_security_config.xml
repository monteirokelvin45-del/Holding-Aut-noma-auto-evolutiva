<?xml version="1.0" encoding="utf-8"?>
<!--
  Tráfego em claro desligado por omissão: o APK só fala HTTPS.

  A única excepção é o loopback do emulador Android (10.0.2.2) e o localhost,
  para que um build de debug possa falar com o backend a correr na máquina do
  programador. Não são endereços alcançáveis num telemóvel real, pelo que a
  excepção não abre nada em produção.

  Sem este ficheiro, o build de debug com -Pautomaton.baseUrl=http://10.0.2.2:8000
  falhava em runtime com "Cleartext HTTP traffic not permitted", sem indicação
  de que o problema era a política de rede.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
