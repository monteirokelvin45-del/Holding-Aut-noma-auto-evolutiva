<?xml version="1.0" encoding="utf-8"?>
<!--
  Política de rede do APK.

  O APK deixou de trazer o endereço do backend fixo no build: o utilizador
  escreve-o no ecrã de ligação. Isso quebrava a política anterior, que só
  autorizava HTTP em claro para 10.0.2.2/localhost — qualquer IP de Wi-Fi
  (192.168.x.x, 10.x.x.x, 172.16-31.x.x) dava
  "Cleartext HTTP traffic not permitted" e a app ficava sem falar com ninguém.

  O que fica decidido, e porquê:

  - HTTPS continua a ser o caminho normal: tráfego em claro desligado por
    omissão (base-config abaixo).
  - HTTP em claro é permitido para localhost, para 10.0.2.2 (emulador) e para
    as três gamas privadas da RFC 1918 + link-local, que é onde um backend
    caseiro vive. Não é possível declarar gamas em XML, por isso estas entradas
    são explícitas e o ApiService valida a mesma regra antes de aceitar um
    endereço — as duas barreiras têm de concordar.
  - Para a internet, HTTP em claro continua proibido: é o que impede que um
    endereço público mal escrito envie o token do APK em texto aberto.

  Nota honesta: um endereço da rede local escrito à mão pode ser outro
  equipamento da mesma Wi-Fi. Isto é um APK de debug para uso pessoal; um
  release de produção não deve permitir cleartext nenhum.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulador Android -> máquina anfitriã -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Nome de rede local (mDNS), ex.: portatil.local -->
        <domain includeSubdomains="true">local</domain>
    </domain-config>
</network-security-config>
